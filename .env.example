# ==========================================
# TSM ECHO & STARLINK DASHBOARD CONFIG
# ==========================================

# Credenciales de acceso a TSM ECHO (https://echo.tsmpatagonia.com.ar/)
# Estas credenciales permiten la sincronización automática de terminales y consumos
ECHO_BASE_URL=https://echo.tsmpatagonia.com.ar/api
ECHO_EMAIL=tu_usuario@tsmpatagonia.com.ar
ECHO_PASSWORD=tu_password_segura

# Base de datos local (SQLite o PostgreSQL)
DATABASE_URL=sqlite:///./starlink_dashboard.db

# Frecuencia de sincronización del worker en segundo plano (minutos)
SYNC_INTERVAL_MINUTES=15
ENABLE_SCHEDULER=true

# Orígenes CORS permitidos
CORS_ORIGINS=["*"]
